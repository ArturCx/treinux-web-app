# Copie para .env e preencha. Nunca commite o .env.

# ── Banco (Neon / PostgreSQL) ───────────────────────────────────────
# Runtime: string de conexão POOLED (host com "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Migrations (prisma migrate): string de conexão DIRETA (sem "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth (Better Auth) ──────────────────────────────────────────────
# Segredo para assinar sessões. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Better Auth Infra (painel + sentinel): chave gerada no painel do Better Auth.
BETTER_AUTH_API_KEY=""
# Opcional: URL pública do app. Em local, http://localhost:3000 já é
# origem confiável; no Vercel é derivada de VERCEL_URL automaticamente.
# BETTER_AUTH_URL="http://localhost:3000"
